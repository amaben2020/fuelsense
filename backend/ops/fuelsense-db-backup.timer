[Unit]
Description=Run the FuelSense Postgres backup nightly

[Timer]
# 01:30 UTC, deliberately ahead of the RDS automated-backup window (02:00-03:00)
# so the two do not contend for the same instance.
OnCalendar=*-*-* 01:30:00
# Spread the S3 write so it is not hammering the same second every night.
RandomizedDelaySec=600
# If the box was down at 01:30, run on next boot rather than skipping the night.
Persistent=true

[Install]
WantedBy=timers.target
